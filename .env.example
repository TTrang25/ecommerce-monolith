# Server
PORT=3000

# JWT
JWT_SECRET=doi-thanh-chuoi-bi-mat-dai-it-nhat-32-ky-tu
JWT_EXPIRES_IN=1h

# PostgreSQL (dùng cho docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

# Dùng khi chạy lệnh Prisma từ máy host (localhost).
# Trong Docker, compose sẽ tự ghi đè bằng host "db".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public